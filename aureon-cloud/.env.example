IDE_DOMAIN=ide.example.com
GIT_DOMAIN=git.example.com
APK_DOMAIN=apk.example.com
AUREON_TOKEN=lamba-random-password-yaha-daalo
# Pehli baar admin banane ke liye true rakho. Admin ban jaye to bhi true hi theek hai (naye log khud join nahi kar payenge).
GIT_DISABLE_REGISTRATION=true
APK_USER=aureon
# Hash banane ke liye: docker run --rm caddy:2 caddy hash-password --plaintext 'tumhara-password'
APK_HASH=
